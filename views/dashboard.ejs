<% layout('layouts/boilerplate') %>
<!-- First row: Dashboard Header + Search -->
<div class="row">
  <div class="input-group flex-nowrap d-flex justify-content-between">
    <h2 class="mx-4">Weather Dashboard</h2>
    <span class="input-group-text" id="addon-wrapping">&#128269;</span>
    <input
      id="searchInput"
      type="text"
      class="form-control"
      placeholder="Search..."
      aria-label="Search"
      aria-describedby="addon-wrapping"
      name="location"
      autofocus
      required
    />
  </div>
</div>
<!-- Second row: Two main boxes -->
<div class="row">
  <!-- Left side -->
  <div class="col-md-8 mt-3">
    <!-- Main weather box -->
    <div class="p-4 bg-white rounded">
      <div class="row">
        <h4 id="header-location">Forecast in <%= weatherData.location %></h4>
        <p id="p-userTime" class="mb-5"><!-- adding content with AJAX --></p>
      </div>
      <div class="row">
        <div class="col-md-4">
          <div class="bg-light p-3 rounded">
            <h3 id="current-temp"><%= weatherData.data.currentTemp %>°F</h3>
            <!-- Originally was "Overcast Clouds"-->
            <p id="weather-description"><%= weatherData.data.description%></p>
            <small id="highAndLow-temp">High: <%= weatherData.data.highTemp %>°F, Low: <%= weatherData.data.lowTemp %>°F</small>
          </div>
        </div>
        <div class="col-md-4">
          <!-- Additional weather details (visibility, humidity, etc.) -->
          <div class="bg-light p-3 rounded">
            <p id="visibility">Visibility: <%=weatherData.data.visibility%> mi</p>
            <p id="humidity">Humidity: <%=weatherData.data.humidity%>%</p>
            <p id="cloudiness">Cloudiness: <%=weatherData.data.cloudiness%>%</p>
          </div>
        </div>
        <div class="col-md-4">
          <!-- Sunrise/sunset info -->
          <div class="bg-light p-3 rounded">
            <p id="sunrise">Sunrise: <%= weatherData.data.sunrise %></p>
            <p id="sunset">Sunset: <%= weatherData.data.sunset %></p>
          </div>
        </div>
      </div>

      <!-- Forecast days (Saturday to Friday) -->
      <div class="row">
        <div id="forecast" class="d-flex justify-content-between mt-4">
          <% weatherData.forecast.forEach(fore => { %>
          <div class="p-2 bg-light rounded text-center">
            <p><%= fore.date %></p>
            <p><%= fore.temp.high %>°F</p>
          </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>

  <!-- Right side (user favorites) -->
  <div class="col-md-4 mt-3">
    <div class="p-4 bg-white rounded">
      <h4>Favorites</h4>
      <ul class="list-unstyled">
        <% favorites.forEach(fav => { %>
        <li class="d-flex justify-content-between">
          <span><%= fav.location %></span>
          <span><%= fav.data.currentTemp %>°F</span>
          <span><%= fav.data.description %></span>
          <button class="btn btn-warning">Remove</button>
        </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
<script src="/javascripts/updateDashboard.js"></script>